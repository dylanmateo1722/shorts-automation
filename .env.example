# Copia este archivo a .env para desarrollo local. NUNCA versiones .env.
#
# El Proof of Concept de Gate 0.5 NO necesita ninguna de estas variables:
# Edge TTS no usa API key y el material visual se genera con FFmpeg.
# Se listan aquí porque las etapas posteriores sí las necesitarán.

# --- LLM (Gate 2: traducción y adaptación) -----------------------------
# El proveedor definitivo sigue sin fijar: se elegirá por evaluación ciega,
# no por herencia de la configuración de MoneyPrinterTurbo (decisión D5).
#
# "fake" no llama a ningún servicio y usa respuestas preparadas; es lo que
# emplean los tests y CI. Cualquier proveedor compatible con la API de Chat
# Completions de OpenAI funciona indicando su base_url.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Respuestas preparadas del proveedor "fake" (lista JSON).
LLM_FAKE_RESPONSES=
# Poner a 0 si el proveedor no admite response_format=json_object.
LLM_JSON_MODE=1
LLM_TIMEOUT_S=120

# --- Capa lingüística ---------------------------------------------------
TARGET_LANGUAGE=es
# Palabras por minuto para estimar la duración. 119 se midió en Gate 0.5 con
# la voz es-CR-JuanNeural; es una estimación, no la duración real del audio.
DEFAULT_WPM=119
TRANSLATION_PROMPT_VERSION=v1
ADAPTATION_PROMPT_VERSION=v1

# --- TTS (Gate 3) -------------------------------------------------------
# Edge TTS es el proveedor inicial y NO requiere credencial. "fake" no llama a
# ningún servicio: genera audio real con FFmpeg y tiempos deterministas, y es
# lo que usan los tests y CI.
TTS_PROVIDER=edge
# Voz de la narración. es-CR-JuanNeural es la única medida (Gate 0.5, 119 wpm);
# cualquier voz de Edge TTS en español sirve.
TTS_VOICE=es-CR-JuanNeural
# Ritmo y tono tal como los acepta el proveedor ("+10%", "-5Hz"). Vacío deja
# los neutros del servicio.
TTS_RATE=
TTS_PITCH=
TTS_TIMEOUT_S=120

# --- Zona segura del subtítulo quemado ----------------------------------
# Heurísticos: la franja inferior de un Short la tapa la interfaz de YouTube,
# pero su altura exacta está pendiente de medir sobre la app real (Gate 5).
SUBTITLE_MARGIN_V=420
SUBTITLE_MARGIN_H=60
SUBTITLE_FONT=DejaVu Sans
SUBTITLE_FONT_SIZE=64

# --- Fallback de TTS (decisión D3) --------------------------------------
# NO IMPLEMENTADO. La interfaz admite otro proveedor, pero ninguno está
# escrito: pedir TTS_PROVIDER=elevenlabs falla con un mensaje explícito, no
# conmuta en silencio. La variable queda documentada para cuando exista.
ELEVENLABS_API_KEY=

# --- YouTube (Gate 7) ---------------------------------------------------
# El consentimiento OAuth inicial se genera una sola vez en una máquina con
# navegador; aquí solo vive el refresh token resultante.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Material de stock (opcional) ---------------------------------------
PEXELS_API_KEY=
