# Copia este archivo a .env para desarrollo local. NUNCA versiones .env.
#
# El Proof of Concept de Gate 0.5 NO necesita ninguna de estas variables:
# Edge TTS no usa API key y el material visual se genera con FFmpeg.
# Se listan aquí porque las etapas posteriores sí las necesitarán.

# --- LLM (Gate 2: traducción y adaptación) -----------------------------
# El proveedor definitivo sigue sin fijar: se elegirá por evaluación ciega,
# no por herencia de la configuración de MoneyPrinterTurbo (decisión D5).
#
# "fake" no llama a ningún servicio y usa respuestas preparadas; es lo que
# emplean los tests y CI. Cualquier proveedor compatible con la API de Chat
# Completions de OpenAI funciona indicando su base_url.
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=
LLM_API_KEY=
# Respuestas preparadas del proveedor "fake" (lista JSON).
LLM_FAKE_RESPONSES=
# Poner a 0 si el proveedor no admite response_format=json_object.
LLM_JSON_MODE=1
LLM_TIMEOUT_S=120

# --- Capa lingüística ---------------------------------------------------
TARGET_LANGUAGE=es
# Palabras por minuto para estimar la duración. 119 se midió en Gate 0.5 con
# la voz es-CR-JuanNeural; es una estimación, no la duración real del audio.
DEFAULT_WPM=119
TRANSLATION_PROMPT_VERSION=v1
ADAPTATION_PROMPT_VERSION=v1

# --- TTS (Gate 3: fallback de D3) --------------------------------------
# Edge TTS es el primario y no requiere credencial.
ELEVENLABS_API_KEY=

# --- YouTube (Gate 7) ---------------------------------------------------
# El consentimiento OAuth inicial se genera una sola vez en una máquina con
# navegador; aquí solo vive el refresh token resultante.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# --- Material de stock (opcional) ---------------------------------------
PEXELS_API_KEY=
